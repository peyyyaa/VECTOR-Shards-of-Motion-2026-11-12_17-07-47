    - target: {fileID: 47988600166616349, guid: e4160907936849c4c81dfebe8db680b9, type: 3}
      propertyPath: title
      value: "Float"
      objectReference: {fileID: 0}
    - target: {fileID: 47988600166616349, guid: e4160907936849c4c81dfebe8db680b9, type: 3}
      propertyPath: body
      value: "Float: hold Jump while falling. Your gravity drops to 1/6 of normal (roughly the Moon compared with Earth), your fall is capped at 2 m/s, and it lasts 1 second per jump.\nFloating never lifts you: it slows your fall, so you stay in the air longer and travel further. A jump alone crosses about 4.9 m; with float, about 9.6 m. You just crossed 5.5 m from the lift.\nYour abilities work in mid-air too: floating gives you time to aim a Burst or a Tether."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: e4160907936849c4c81dfebe8db680b9, type: 3}
