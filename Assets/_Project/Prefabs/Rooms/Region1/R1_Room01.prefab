--- !u!1001 &5060457402156166417
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 8276731506047425992}
    m_Modifications:
    - target: {fileID: 47988600166616349, guid: e4160907936849c4c81dfebe8db680b9, type: 3}
      propertyPath: body
      value: "Each of you has a gift. Kinetic Burst (P1) gives a sudden shove: an impulse. Wind Tether (P2) pulls steadily from a distance.\nInertia: an object stays still until a net force moves it (Newton's First Law). Friction holds the 3 kg crate with up to μ·m·g ≈ 29.4 N, more than two pushes (24 N) or the tether (24 N), so the forces stay balanced and it won't budge. A burst changes its velocity at once: Δv = 15 / 3 = 5 m/s.\nPlates measure weight, W = m·g: one player 29.4 N, the keystone (2 kg) 58.9 N, the crate (3 kg) 88.3 N."

        (Journal entry to
        be written with the room.)'
      objectReference: {fileID: 0}
    - target: {fileID: 47988600166616349, guid: e4160907936849c4c81dfebe8db680b9, type: 3}
      propertyPath: title
      value: "1 \xB7 The First Exchange"
      objectReference: {fileID: 0}
    - target: {fileID: 2717266876637095741, guid: e4160907936849c4c81dfebe8db680b9, type: 3}
      propertyPath: m_Name
