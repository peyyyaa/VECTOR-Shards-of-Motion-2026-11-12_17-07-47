  m_Script: {fileID: 11500000, guid: 15524a66b3998f499c2af44defc64bb6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::JournalStone
  title: "Friction and Torque"
  body: "Wet stone (μ = 0.05): friction on 2 kg is only 2.9 N, so one push moves it and it slides far.\nMoss (μ = 0.6): friction is 35.3 N, so even push + tether (36 N) barely moves it.\nSeesaw: torque = force × distance from the pivot. The 3 kg crate lifts one player; two players tip it back."
  closeDistance: 3
